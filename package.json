{
    "name": "wow-launcher",
    "version": "1.0.0",
    "description": "WoW 3.3.5a Client Launcher built with Electron",
    "main": "src/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron . --inspect=5858",
        "build": "electron-builder",
        "dist": "npm run build"
    },
    "keywords": [
        "wow",
        "launcher",
        "electron",
        "3.3.5a"
    ],
    "author": "AC Launcher Team",
    "license": "MIT",
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.6.4"
    },
    "dependencies": {
        "axios": "^1.6.2",
        "fs-extra": "^11.2.0",
        "node-stream-zip": "^1.15.0",
        "dotenv": "^16.3.1"
    },
    "build": {
        "appId": "com.aclauncher.wow335a",
        "productName": "WoW 3.3.5a Launcher",
        "directories": {
            "output": "dist"
        },
        "files": [
            "src/**/*",
            "assets/**/*",
            "node_modules/**/*"
        ],
        "mac": {
            "category": "public.app-category.games"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}