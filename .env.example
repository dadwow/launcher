# WoW 3.3.5a Launcher Configuration

# Download URL for the WoW client files (zip archive)
CLIENT_DOWNLOAD_URL=https://example.com/wow-client-335a.zip

# Default realm address for realmlist.wtf
DEFAULT_REALM=logon.your-server.com

# Default installation path (leave empty to use Documents/World of Warcraft)
WOW_INSTALL_PATH=

# Server name to display in the launcher
SERVER_NAME=Your WoW Server

# Launcher window dimensions
WINDOW_WIDTH=800
WINDOW_HEIGHT=600

# Enable development mode (shows dev tools)
DEV_MODE=false